    {
      "parameters": {
        "content": "## The AI receptionist finishes a conversation\nGHL kept this in seven fdai_ fields on the contact, so every new\nconversation overwrote the last and no history survived. Here\neach conversation is its own record, which is the only way to\nask whether the agent is getting better or worse.",
        "height": 380,
        "width": 540,
        "color": 5
      },
      "id": "015648359040",
      "name": "1. The AI receptionist finishes a conversation",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        80
      ]
    },
    {
      "parameters": {
        "content": "## Attach it to a person\nSame email match as everywhere else, so an AI conversation and a\nwebinar registration for the same address land on one record.",
        "height": 470,
        "width": 1300,
        "color": 4
      },
      "id": "853388261409",
      "name": "2. Attach it to a person",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        540,
        180
      ]
    },
    {
      "parameters": {
        "content": "## Escalate only when the agent asked\nThe agent hands over when it cannot help. That is the moment a\nperson is most likely to be lost, so it becomes a task and a\nmessage \u2014 not a row someone might read later.",
        "height": 490,
        "width": 860,
        "color": 6
      },
      "id": "259587075909",
      "name": "3. Escalate only when the agent asked",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        780
      ]
    }
