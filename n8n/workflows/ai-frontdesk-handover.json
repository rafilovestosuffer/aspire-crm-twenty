{
  "name": "AI FrontDesk Handover",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "frontdesk-ai",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "426872770567",
      "name": "Conversation ended",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Field names mirror GHL's fdai_* keys so the agent does not have to change.\nconst b = $input.first().json.body || {};\nconst email = String(b.email || b.fdai_email || '').trim().toLowerCase();\nif (!email.includes('@')) {\n  throw new Error(`FrontDesk AI payload without a usable email: ${JSON.stringify(b).slice(0, 200)}`);\n}\nconst nps = Number(b.fdai_nps ?? b.nps);\nconst handoverReason = String(b.fdai_handover_reason || b.handoverReason || '').trim();\n\nreturn [{ json: {\n  email,\n  firstName: String(b.firstName || '').trim(),\n  lastName: String(b.lastName || '').trim(),\n  intent: String(b.fdai_intent || b.intent || '').slice(0, 500),\n  summary: String(b.fdai_convo_summary || b.summary || '').slice(0, 5000),\n  handoverReason,\n  appointmentInterest: String(b.fdai_appointment_interest || '').slice(0, 500),\n  reviewIntent: String(b.fdai_review_intent || '').slice(0, 500),\n  pageUrl: String(b.fdai_page_url || b.pageUrl || '').slice(0, 500),\n  nps: Number.isFinite(nps) ? nps : null,\n  handedOver: Boolean(handoverReason),\n}}];"
      },
      "id": "844052764077",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people?filter=emails.primaryEmail[eq]:{{ encodeURIComponent($('Normalise').first().json.email) }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "041669482608",
      "name": "Find person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const found = ($input.first().json.data?.people || [])[0];\nreturn [{ json: { ...$('Normalise').first().json, existingId: found?.id || null } }];"
      },
      "id": "238021690398",
      "name": "Person exists?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.existingId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notExists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "138062857593",
      "name": "New person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"name\": {\"firstName\": $json.firstName, \"lastName\": $json.lastName }, \"emails\": {\"primaryEmail\": $json.email } }) }}"
      },
      "id": "072062033468",
