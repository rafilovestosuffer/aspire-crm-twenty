{
  "name": "EVT Webinar Registration",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webinar-register",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "436154681561",
      "name": "Registration",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The payload comes from a landing page we do not fully control, so validate\n// rather than trust. A registration with no email cannot be confirmed, cannot\n// be reminded and cannot be counted \u2014 reject it loudly instead of writing a\n// half record nobody will ever notice is broken.\nconst b = $input.first().json.body || {};\nconst email = String(b.email || '').trim().toLowerCase();\nif (!email.includes('@')) {\n  throw new Error(`webinar registration without a usable email: ${JSON.stringify(b).slice(0, 200)}`);\n}\nconst SOURCES = ['Email','Social Media','Word of Mouth','Online Advertisement',\n                 'Website or Blog','Search Engine','Other'];\nconst raw = String(b.source || '').trim();\nconst source = SOURCES.find(s => s.toLowerCase() === raw.toLowerCase()) || 'Other';\n\nreturn [{ json: {\n  email,\n  firstName: String(b.firstName || b.first_name || '').trim(),\n  lastName: String(b.lastName || b.last_name || '').trim(),\n  webinarId: String(b.webinarId || '').trim(),\n  webinarTitle: String(b.webinarTitle || 'Aspire webinar').trim(),\n  source: source.toUpperCase().replace(/ /g, '_'),\n  consent: b.consent !== false,\n}}];"
      },
      "id": "769990311252",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people?filter=emails.primaryEmail[eq]:{{ encodeURIComponent($('Normalise').first().json.email) }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "771534102546",
      "name": "Find person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const found = ($input.first().json.data?.people || [])[0];\nreturn [{ json: { ...$('Normalise').first().json, existingId: found?.id || null } }];"
      },
      "id": "033654515386",
      "name": "Person exists?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.existingId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notExists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "361834171845",
      "name": "New person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"name\": {\"firstName\": $json.firstName, \"lastName\": $json.lastName }, \"emails\": {\"primaryEmail\": $json.email } }) }}"
      },
      "id": "850797256266",
      "name": "Create person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1220,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {},
      "id": "904696751413",
      "name": "Known person",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1220,
        490
      ]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "119792037259",
      "name": "Person ready",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/consentRecords?filter=personId[eq]:{{ encodeURIComponent($('Person exists?').first().json.existingId || $('Create person').first().json.data.createPerson.id) }}&order_by=effectiveAt[DescNullsLast]&limit=5",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "046595952465",
      "name": "Prior opt-out?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        0,
        920
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.data?.consentRecords || [];\nconst SUPPRESSED = ['OPTED_OUT', 'BOUNCED', 'COMPLAINED'];\nconst block = rows.find(r => SUPPRESSED.includes(r.status)) || null;\nconst d = $('Normalise').first().json;\nreturn [{ json: { ...d,\n  status: block ? 'PENDING' : (d.consent ? 'OPTED_IN' : 'PENDING'),\n  proof: block\n    ? `webinar registration ${$execution.id}; NOT re-subscribed, prior ${block.status}`\n    : `webinar registration ${$execution.id}`,\n}}];"
      },
      "id": "866362781436",
      "name": "Consent status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        920
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/consentRecords",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"channel\": \"EMAIL\", \"status\": $('Consent status').first().json.status, \"source\": \"FORM_SUBMISSION\", \"effectiveAt\": $now.toUTC().toISO(), \"proof\": $('Consent status').first().json.proof, \"personId\": $('Person exists?').first().json.existingId || $('Create person').first().json.data.createPerson.id }) }}"
      },
      "id": "889000325377",
      "name": "Record consent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        920
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarRegistrations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
