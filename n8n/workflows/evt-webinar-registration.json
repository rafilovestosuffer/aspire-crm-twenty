        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"registeredAt\": $now.toUTC().toISO(), \"attended\": false, \"remindersSent\": 0, \"source\": $('Normalise').first().json.source, \"personId\": $('Person exists?').first().json.existingId || $('Create person').first().json.data.createPerson.id, \"webinarEventId\": $('Normalise').first().json.webinarId || null }) }}"
      },
      "id": "279543482415",
      "name": "Record registration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        660,
        920
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "VEND Send Email",
          "mode": "list"
        },
        "workflowInputs": {
          "value": {
            "personId": "={{ $('Person exists?').first().json.existingId || $('Create person').first().json.data.createPerson.id }}",
            "templateKey": "webinar_confirm",
            "mergeData": "={{ { \"webinarTitle\": $('Normalise').first().json.webinarTitle } }}"
          }
        },
        "options": {}
      },
      "id": "652026221459",
      "name": "Send confirmation",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        920
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/automationRuns",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"workflowName\": \"EVT Webinar Registration\", \"status\": \"SUCCESS\", \"startedAt\": $execution.startedAt, \"n8nExecutionId\": $execution.id }) }}"
      },
      "id": "002473025211",
      "name": "Log run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1100,
        920
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "content": "## Someone signs up for a webinar\nLanding pages post here when a person registers. This is the\nbusiest thing the company does: submissions arrive in spikes\naround each event \u2014 44 in one December, 1 in a quiet February \u2014\nso the funnel has to be event-shaped, not a steady trickle.",
        "height": 400,
        "width": 540,
        "color": 5
      },
      "id": "076893167323",
      "name": "1. Someone signs up for a webinar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        60
      ]
    },
    {
      "parameters": {
        "content": "## Make sure we know who they are\nOne record per human, matched on email. Someone who registers\nfor three webinars is one person with three registrations, not\nthree contacts \u2014 otherwise their history splits and nobody can\nsee they have been to two events already.",
        "height": 510,
        "width": 1080,
        "color": 4
      },
      "id": "711094923513",
      "name": "2. Make sure we know who they are",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        540,
        140
      ]
    },
    {
      "parameters": {
        "content": "## Record the registration and the consent\nThe registration is its own record, linked to the event and the\nperson, so attendance can be tracked against it later. Consent is\nwritten at the same moment, because a sign-up is the clearest\npermission we will ever have and it must be evidenced.",
        "height": 320,
        "width": 860,
        "color": 3
      },
      "id": "362438163839",
      "name": "3. Record the registration and the consent",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        760
      ]
    },
    {
      "parameters": {
        "content": "## Confirm it, and count it\nSend the confirmation through the one workflow allowed to send\nemail, so the consent gate applies here exactly as everywhere\nelse. Then bump the registration count on the event, which is\nwhat tells us whether a topic is working before it runs.",
        "height": 380,
        "width": 540,
        "color": 2
      },
      "id": "075456725873",
      "name": "4. Confirm it, and count it",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        860,
        700
      ]
    }
  ],
