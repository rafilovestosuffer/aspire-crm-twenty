{
  "name": "EVT Post-Webinar Follow-up",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * *"
            }
          ]
        }
      },
      "id": "774505219623",
      "name": "Daily 11:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarEvents?filter=scheduledAt[gte]:{{ encodeURIComponent($now.minus({ days: 3 }).toUTC().toISO()) }},scheduledAt[lte]:{{ encodeURIComponent($now.toUTC().toISO()) }}&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "starting_after",
                    "value": "={{ $response.body.pageInfo.endCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.pageInfo.hasNextPage }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 700
            }
          }
        }
      },
      "id": "614586594985",
      "name": "Finished webinars",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarRegistrations?filter=registeredAt[gte]:{{ encodeURIComponent($now.minus({ days: 120 }).toUTC().toISO()) }}&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "starting_after",
                    "value": "={{ $response.body.pageInfo.endCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.pageInfo.hasNextPage }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 700
            }
          }
        }
      },
      "id": "236319674419",
      "name": "Registrations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const pageAll = (nodeName, key) => {\n  const pages = $(nodeName).all();\n  const rows = [];\n  for (const p of pages) rows.push(...(p.json.data?.[key] || []));\n  const total = pages.length ? pages[0].json.totalCount : 0;\n  if (typeof total === 'number' && total > rows.length) {\n    throw new Error(\n      `${nodeName}: read ${rows.length} of ${total} ${key} over ${pages.length} page(s) \u2014 ` +\n      `the scan stopped early, so this run saw only part of the data. ` +\n      `Raise maxRequests on that node.`);\n  }\n  return rows;\n};const events = pageAll('Finished webinars', 'webinarEvents');\nconst regs   = pageAll('Registrations',     'webinarRegistrations');\n\nconst byEvent = new Map();\nfor (const r of regs) {\n  if (!r.webinarEventId) continue;\n  if (!byEvent.has(r.webinarEventId)) byEvent.set(r.webinarEventId, []);\n  byEvent.get(r.webinarEventId).push(r);\n}\n\nconst out = [];\nfor (const e of events) {\n  // COMPLETED is the guard against sending the same follow-up on consecutive\n  // mornings \u2014 the three-day window above deliberately overlaps so a failed\n  // run gets another chance, and without this flag that retry becomes a\n  // duplicate send to everyone who already had one.\n  if (e.status === 'COMPLETED') continue;\n  const rows = byEvent.get(e.id) || [];\n  const attended = rows.filter(r => r.attended === true);\n\n  for (const r of rows) {\n    out.push({ json: {\n      personId: r.personId,\n      templateKey: r.attended === true ? 'webinar_survey' : 'webinar_replay',\n      webinarTitle: e.name || e.topic || 'Aspire webinar',\n      eventId: e.id,\n      attendeeCount: attended.length,\n      registrationCount: rows.length,\n    }});\n  }\n}\nconst IDLE_REASON = `no webinar finished with anyone to follow up (${events.length} in window)`;\nif (!out.length) {\n  return [{ json: { idle: true, reason: IDLE_REASON } }];\n}\nreturn out;"
      },
      "id": "718643976367",
      "name": "Split attended from no-show",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "278739076298",
      "name": "One at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "VEND Send Email",
          "mode": "list"
        },
        "workflowInputs": {
          "value": {
            "personId": "={{ $json.personId }}",
            "templateKey": "={{ $json.templateKey }}",
            "mergeData": "={{ { \"webinarTitle\": $json.webinarTitle } }}"
          }
        },
        "options": {}
      },
      "id": "486799015620",
      "name": "Send follow-up",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "833598968968",
      "name": "Pace the sends",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Split attended from no-show').all().map(i => i.json);\nconst byId = new Map();\nfor (const r of rows) {\n  if (r.eventId && !byId.has(r.eventId)) byId.set(r.eventId, r);\n}\nreturn [...byId.values()].map(r => ({ json: {\n  eventId: r.eventId,\n  attendeeCount: r.attendeeCount,\n  registrationCount: r.registrationCount,\n}}));"
      },
      "id": "452805444052",
      "name": "Events to close",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarEvents/{{ $json.eventId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"status\": \"COMPLETED\", \"attendeeCount\": $json.attendeeCount, \"registrationCount\": $json.registrationCount }) }}"
      },
      "id": "656699681871",
      "name": "Close the event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1880,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/automationRuns",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
