        "jsonBody": "={{ JSON.stringify({\"name\": 'Renewal \u2014 ' + $json.name, \"stage\": \"NEW\", \"closeDate\": $json.renewalDate, \"companyId\": $json.companyId}) }}"
      },
      "id": "513878306770",
