    "Send by SMTP": {
      "main": [
        [
          {
            "node": "Log message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "SYS Error Handler"
  },
  "meta": {
    "description": "Sub-workflow. Input: { personId, templateKey, mergeData }. Checks consent, renders the template, sends by SMTP, logs a messageLog. No other workflow may call SMTP directly."
  },
  "tags": [
    {
      "name": "aspire"
    }
  ]
}