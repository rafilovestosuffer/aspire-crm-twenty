      "id": "587984983000",
      "name": "Nurture runs last 26h",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const named = [\n  ['SUB Renewal Escalation', 'Renewal runs last 26h'],\n  ['OPS Scheduled Sweeps',   'Sweep runs last 26h'],\n  ['LEAD Nurture Sequence',  'Nurture runs last 26h'],\n];\n\n// 26 hours, not 24: a daily job that drifts by an hour must not raise a false\n// alarm every single morning. An alert people learn to ignore is worthless.\nconst missing = [];\nconst failed = [];\nfor (const [label, node] of named) {\n  const page = $(node).first().json || {};\n  const rows = page.data?.automationRuns || [];\n  const n = typeof page.totalCount === 'number' ? page.totalCount : rows.length;\n  if (!n) missing.push(label);\n  for (const r of rows) {\n    if (r.status === 'FAILED') failed.push(r.workflowName || label);\n  }\n}\n\nconst problems = [];\nif (missing.length) {\n  problems.push(`did not run in the last 26h: ${missing.join(', ')}`);\n}\nif (failed.length) {\n  problems.push(`${failed.length} failed run(s): ` +\n                [...new Set(failed)].slice(0, 3).join(', '));\n}\n\nreturn [{ json: {\n  healthy: problems.length === 0,\n  problems: problems.join(' | '),\n  checked: named.length,\n}}];"
      },
      "id": "865011195768",
      "name": "Anything missing?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.healthy }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "301401503943",
      "name": "All well?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
