      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarEvents?filter=scheduledAt[gte]:{{ encodeURIComponent($now.toUTC().toISO()) }},scheduledAt[lte]:{{ encodeURIComponent($now.plus({ hours: 48 }).toUTC().toISO()) }}&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "starting_after",
                    "value": "={{ $response.body.pageInfo.endCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.pageInfo.hasNextPage }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 700
            }
          }
        }
      },
      "id": "766152679103",
      "name": "Upcoming webinars",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        220,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/webinarRegistrations?filter=registeredAt[gte]:{{ encodeURIComponent($now.minus({ days: 120 }).toUTC().toISO()) }}&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "starting_after",
                    "value": "={{ $response.body.pageInfo.endCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.pageInfo.hasNextPage }}",
              "limitPagesFetched": true,
              "maxRequests": 50,
              "requestInterval": 700
            }
          }
        }
      },
      "id": "212453083141",
      "name": "Registrations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const pageAll = (nodeName, key) => {\n  const pages = $(nodeName).all();\n  const rows = [];\n  for (const p of pages) rows.push(...(p.json.data?.[key] || []));\n  const total = pages.length ? pages[0].json.totalCount : 0;\n  if (typeof total === 'number' && total > rows.length) {\n    throw new Error(\n      `${nodeName}: read ${rows.length} of ${total} ${key} over ${pages.length} page(s) \u2014 ` +\n      `the scan stopped early, so this run saw only part of the data. ` +\n      `Raise maxRequests on that node.`);\n  }\n  return rows;\n};// A short read here means someone silently never gets reminded, which shows\n// up as a low attendance rate that nobody can explain.\nconst events = pageAll('Upcoming webinars', 'webinarEvents');\nconst regs   = pageAll('Registrations',     'webinarRegistrations');\n\nconst byEvent = new Map();\nfor (const e of events) byEvent.set(e.id, e);\n\nconst now = Date.now();\nconst out = [];\n\nfor (const r of regs) {\n  const e = byEvent.get(r.webinarEventId);\n  if (!e || !e.scheduledAt) continue;\n  if (r.attended === true) continue;\n\n  const hoursAway = (new Date(e.scheduledAt).getTime() - now) / 3600000;\n  if (hoursAway <= 0) continue;\n\n  // remindersSent is the idempotency key: 0 -> the 24h note is still owed,\n  // 1 -> only the 1h note remains, 2 -> done. Sending on a time window alone\n  // would re-send every hour the window stayed open.\n  const done = Number(r.remindersSent || 0);\n  let key = null;\n  if (hoursAway <= 1.5 && done < 2) key = 'webinar_reminder_1h';\n  else if (hoursAway <= 24 && done < 1) key = 'webinar_reminder_24h';\n  if (!key) continue;\n\n  out.push({ json: {\n    registrationId: r.id,\n    personId: r.personId,\n    templateKey: key,\n    remindersSent: key === 'webinar_reminder_1h' ? 2 : 1,\n    webinarTitle: e.name || e.topic || 'Aspire webinar',\n    scheduledAt: e.scheduledAt,\n  }});\n}\nreturn out;"
      },
      "id": "004977696386",
      "name": "Who to remind",
