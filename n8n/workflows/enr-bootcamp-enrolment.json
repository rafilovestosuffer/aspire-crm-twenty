{
  "name": "ENR Bootcamp Enrolment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "enrol",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "914054023072",
      "name": "Enrolment request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Tiers are the six FastPayDirect links found in GHL. An unknown tier must\n// not fall through to a default: sending the wrong payment link charges the\n// wrong amount, and that is a refund and an apology, not a bug report.\nconst TIERS = ['BRONZE','SILVER','GOLD','PLATINUM','DIAMOND','TITANIUM'];\nconst b = $input.first().json.body || {};\nconst email = String(b.email || '').trim().toLowerCase();\nif (!email.includes('@')) {\n  throw new Error(`enrolment without a usable email: ${JSON.stringify(b).slice(0, 200)}`);\n}\nconst tier = String(b.tier || '').trim().toUpperCase();\nif (!TIERS.includes(tier)) {\n  throw new Error(`unknown enrolment tier \"${b.tier}\" \u2014 expected one of ${TIERS.join(', ')}`);\n}\n\n// The link per tier is configuration, not code: prices and providers change\n// more often than workflows do. Missing config fails loudly here rather than\n// mailing somebody an empty link.\nconst links = {};\nfor (const pair of String($env.ENROL_PAYMENT_LINKS || '').split(',')) {\n  const [k, v] = pair.split('=');\n  if (k && v) links[k.trim().toUpperCase()] = v.trim();\n}\nconst paymentLinkUrl = links[tier] || '';\nif (!paymentLinkUrl) {\n  throw new Error(`no payment link configured for tier ${tier}. Set ENROL_PAYMENT_LINKS in infra/.env`);\n}\n\nreturn [{ json: {\n  email,\n  firstName: String(b.firstName || b.first_name || '').trim(),\n  lastName: String(b.lastName || b.last_name || '').trim(),\n  tier,\n  paymentLinkUrl,\n  cohortId: String(b.cohortId || '').trim(),\n  programName: String(b.programName || 'Aspire bootcamp').trim(),\n  amount: Number(b.amount || 0),\n}}];"
      },
      "id": "487297382083",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people?filter=emails.primaryEmail[eq]:{{ encodeURIComponent($('Normalise').first().json.email) }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "655406211714",
      "name": "Find person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
