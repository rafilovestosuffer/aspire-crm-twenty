            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"title\": 'Follow up: ' + $json.firstName + ' ' + $json.lastName + ' (' + $json.band + ', score ' + $json.score + ')', \"status\": \"TODO\", \"dueAt\": $now.plus({ days: 1 }).toISO(), \"body\": $json.interest + '\\n\\n' + $json.message}) }}"
      },
      "id": "067706977871",
      "name": "Create task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
