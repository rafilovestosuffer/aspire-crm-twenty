    {
      "parameters": {
        "select": "channel",
        "channelId": "#sales",
        "text": "=:inbox_tray: *New lead \u2014 {{ $('Score and route').first().json.band }}* (score {{ $('Score and route').first().json.score }})\n*{{ $('Score and route').first().json.firstName }} {{ $('Score and route').first().json.lastName }}* \u2014 {{ $('Score and route').first().json.companyName }}\nInterest: {{ $('Score and route').first().json.interest }}\n{{ $('Score and route').first().json.email }}",
        "otherOptions": {}
      },
      "id": "789868392004",
      "name": "Notify sales",
