            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"channel\": \"EMAIL\", \"status\": $('Consent status').first().json.status, \"source\": \"FORM_SUBMISSION\", \"effectiveAt\": $now.toUTC().toISO(), \"proof\": $('Consent status').first().json.proof, \"personId\": $('Exists?').first().json.existingId || $('Create person').first().json.data.createPerson.id }) }}"
      },
