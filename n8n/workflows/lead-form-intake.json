{
  "name": "LEAD Form Intake",
  "nodes": [
    {
      "parameters": {
        "path": "aspire-contact",
        "formTitle": "Talk to Aspire Tech",
        "formDescription": "Tell us what you need and a security specialist will reply within one business day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "First name",
              "requiredField": true
            },
            {
              "fieldLabel": "Last name",
              "requiredField": true
            },
            {
              "fieldLabel": "Work email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Company",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone",
              "fieldType": "text"
            },
            {
              "fieldLabel": "What do you need help with?",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "SOC / managed detection"
                  },
                  {
                    "option": "CMMC or compliance"
                  },
                  {
                    "option": "Security awareness training"
                  },
                  {
                    "option": "Incident response"
                  },
                  {
                    "option": "Something else"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "I agree to be contacted by Aspire Tech",
              "fieldType": "checkbox",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "991603865883",
      "name": "Public form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise at the edge. Everything downstream can then assume clean values.\nconst j = $input.first().json;\nconst email = String(j['Work email'] || '').trim().toLowerCase();\nconst phoneRaw = String(j['Phone'] || '').replace(/[^0-9+]/g, '');\n\nreturn [{ json: {\n  firstName: String(j['First name'] || '').trim(),\n  lastName:  String(j['Last name']  || '').trim(),\n  email,\n  phone: phoneRaw ? (phoneRaw.startsWith('+') ? phoneRaw : '+1' + phoneRaw) : '',\n  companyName: String(j['Company'] || '').trim(),\n  interest: j['What do you need help with?'] || '',\n  message: String(j['Message'] || '').slice(0, 2000),\n  consent: j['I agree to be contacted by Aspire Tech'] === true,\n  emailDomain: email.split('@')[1] || '',\n}}];"
      },
      "id": "360327421684",
      "name": "Normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people?filter[emails.primaryEmail][eq]={{ $json.email }}&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "821510248581",
      "name": "Find person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Idempotency: forms get double-submitted and webhooks get retried. Search\n// before create, always \u2014 cleaning duplicates later costs far more.\nconst found = ($input.first().json.data?.people || [])[0];\nreturn [{ json: { ...$('Normalise').first().json,\n                  existingId: found?.id || null } }];"
      },
      "id": "653263168856",
      "name": "Exists?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.existingId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notExists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "465639678031",
      "name": "New person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"name\": {\"firstName\": $json.firstName, \"lastName\": $json.lastName}, \"emails\": {\"primaryEmail\": $json.email}, \"phones\": {\"primaryPhoneNumber\": $json.phone}}) }}"
      },
      "id": "569912543341",
      "name": "Create person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/people/{{ $json.existingId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"phones\": {\"primaryPhoneNumber\": $json.phone}}) }}"
      },
      "id": "631139439493",
      "name": "Update person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1320,
        480
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "007071553198",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/consentRecords",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"channel\": \"EMAIL\", \"status\": $('Normalise').first().json.consent ? 'OPTED_IN' : 'PENDING', \"source\": \"FORM_SUBMISSION\", \"effectiveAt\": $now.toISO(), \"proof\": 'n8n form execution ' + $execution.id}) }}"
      },
      "id": "774894214539",
      "name": "Record consent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1760,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/formSubmissions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\"submittedAt\": $now.toISO(), \"consentGiven\": $('Normalise').first().json.consent, \"payload\": JSON.stringify($('Normalise').first().json)}) }}"
      },
      "id": "177187483438",
      "name": "Log submission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1980,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Twenty API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Transparent scoring \u2014 a rule anyone can read and argue with, unlike GHL's\n// opaque engagement score.\nconst d = $('Normalise').first().json;\nconst FREE = ['gmail.com','yahoo.com','hotmail.com','outlook.com','aol.com','icloud.com'];\n\nlet score = 0;\nif (d.emailDomain && !FREE.includes(d.emailDomain)) score += 30; else score -= 40;\nif (/cmmc|compliance|soc|incident/i.test(d.interest)) score += 25;\nif (/cmmc|cui|fci|dfars|nist/i.test(d.message))       score += 20;\nif (d.phone)                                          score += 10;\n\n// Deterministic round-robin: hashing the email keeps a person with the same\n// rep across re-runs, and needs no counter stored anywhere.\nconst REPS = (process.env.ASPIRE_REP_IDS || '').split(',').filter(Boolean);\nconst hash = [...d.email].reduce((a, c) => a + c.charCodeAt(0), 0);\n\nreturn [{ json: { ...d, score,\n  band: score >= 60 ? 'HOT' : score >= 30 ? 'WARM' : 'COLD',\n  assigneeId: REPS.length ? REPS[hash % REPS.length] : null }}];"
      },
      "id": "039962834506",
      "name": "Score and route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_BASE_URL }}/rest/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
