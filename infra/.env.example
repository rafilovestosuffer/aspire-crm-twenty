# Copy to infra/.env and fill in — or just run ./infra/up.sh, which generates
# every missing secret for you. Never commit infra/.env.

# ---- Versions -------------------------------------------------------------
# v2.1.0 (2026-04-24) is the first release Twenty marks production-ready for
# single-tenant self-hosting. Pin it. Never run `latest` in production: an
# unattended image change can run migrations you did not choose.
TAG=v2.1.0
N8N_TAG=latest

# ---- Postgres -------------------------------------------------------------
# Set deliberately at first run. The value is baked into the data volume;
# changing it later without removing the volume breaks authentication.
# Strong, but no special characters — it goes into a connection URL.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=

# ---- Twenty ---------------------------------------------------------------
# How the browser reaches Twenty, including scheme. Used for generated links
# and to decide whether cookies are secure. Wrong value = login redirect loop.
#   laptop : http://localhost:3000
#   VPS    : https://crm.aspiretss.com
SERVER_URL=http://localhost:3000
TWENTY_PORT=3000

# openssl rand -base64 32
# Losing this loses every secret in the database. Back it up OFF this machine.
ENCRYPTION_KEY=
# Only during a key rotation: set to the previous ENCRYPTION_KEY.
FALLBACK_ENCRYPTION_KEY=
# Required. Upstream's .env.example calls this legacy, but v2.1.0 throws
# "APP_SECRET is not set" at boot without it. up.sh generates it.
APP_SECRET=

STORAGE_TYPE=local

# ---- SMTP (shared by Twenty and the n8n send sub-workflow) ---------------
# Powers invites, password resets, and every email the workflows send.
#
# Leave the SMTP block blank on a local build: scripts/n8n_credentials.py then
# points n8n at the Mailpit container, so the whole send path — consent gate,
# template render, messageLog write, SMTP transaction — runs for real with
# nothing leaving the host. Read the mail at http://localhost:8025.
EMAIL_DRIVER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ---- Twenty mailbox + calendar sync (optional) ---------------------------
# Native two-way Gmail/Workspace sync. Threads and calendar events appear on
# record timelines — the closest native equivalent to GHL's inbox.
# Requires a Google Cloud OAuth client.
MESSAGING_PROVIDER_GMAIL_ENABLED=
CALENDAR_PROVIDER_GOOGLE_ENABLED=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=
AUTH_GOOGLE_APIS_CALLBACK_URL=

# ---- n8n ------------------------------------------------------------------
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_PORT=5678
# openssl rand -base64 32 — losing this loses every stored n8n credential.
N8N_ENCRYPTION_KEY=

# ---- Workflow configuration ----------------------------------------------
# From address for transactional email sent by n8n.
ASPIRE_FROM_EMAIL=
# Twenty workspace-member UUIDs for round-robin lead assignment, comma
# separated. Leave blank until users exist — leads then stay unassigned
# rather than failing.
ASPIRE_REP_IDS=

# Chat alerts. Any incoming-webhook URL that accepts {"text": "..."} — Slack,
# Mattermost, Discord (add /slack), Google Chat. Not the Slack API node: that
# needs an OAuth app, which cannot be created headlessly and left these
# workflows untestable.
#
# The default points at the dev alert sink workflow, which files each alert as
# an automationRun so alerting is provable before any workspace exists.
# Set the real hook URL for production.
ALERT_WEBHOOK_URL=http://n8n:5678/webhook/alert-sink
# Optional: separate destination for sales notifications. Falls back to
# ALERT_WEBHOOK_URL when blank.
SALES_WEBHOOK_URL=

TZ=UTC

# ---- Scripts (not read by docker compose) --------------------------------
# Twenty → Settings → API & Webhooks → create key
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
# n8n → Settings → n8n API → create key, or scripts/bootstrap_n8n.py
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Local mail catcher, used by scripts/prove_workflows.py. Dev profile only.
MAILPIT_UI_PORT=8025
MAILPIT_URL=http://localhost:8025
