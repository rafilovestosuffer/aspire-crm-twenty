# Copy to infra/.env and fill in. Never commit infra/.env.
#
# Generate each secret separately:
#   openssl rand -base64 32

# ---- Postgres (shared by Twenty and n8n) ----
# Set deliberately at first run. The value is baked into the data volume;
# changing it later without removing the volume breaks authentication.
PG_USER=postgres
PG_PASSWORD=

# ---- Twenty ----
# Public URL including scheme. Must match how the app is actually reached,
# or login enters a redirect loop.
TWENTY_SERVER_URL=https://crm.aspiretss.com
TWENTY_APP_SECRET=
# Losing this loses every stored secret, OAuth tokens included. Back it up
# somewhere other than this host.
TWENTY_ENCRYPTION_KEY=
TWENTY_VERSION=latest

# ---- n8n ----
N8N_HOST=automation.aspiretss.com
N8N_PUBLIC_URL=https://automation.aspiretss.com
N8N_ENCRYPTION_KEY=
N8N_USER=admin
N8N_PASSWORD=
N8N_VERSION=latest

# ---- Workflow configuration ----
# From address for transactional email sent by n8n.
ASPIRE_FROM_EMAIL=hello@aspiretss.com
# Twenty workspace-member UUIDs for round-robin lead assignment, comma
# separated. Leave blank until the users exist; leads then stay unassigned
# rather than failing.
ASPIRE_REP_IDS=

TZ=UTC
