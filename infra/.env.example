# Copy to infra/.env and fill in.
#
# Laptop:  ./infra/up.sh generates any blank secret for you.
# VPS:     ./infra/init-vps-env.sh --yes
#          That copies this file, generates secrets, sets the public
#          hostnames, and lists the lines only you can fill (SMTP,
#          office IPs, chat webhook, payment links). Do not copy a
#          laptop .env onto the server — LIVE_MAIL_ALLOWLIST and the
#          local alert-sink URL would follow it.

# ---- Versions -------------------------------------------------------------
# v2.1.0 (2026-04-24) is the first release Twenty marks production-ready for
# single-tenant self-hosting. Pin it. Never run `latest` in production: an
# unattended image change can run migrations you did not choose.
TAG=v2.1.0
# Pinned, for the same reason TAG is pinned above. `latest` means the VPS
# pulls whatever n8n released that morning — a version nobody has run these
# workflows against. n8n changes node typeVersions between releases, and a
# workflow built for one version can silently behave differently on the next.
# 2.34.6 is the version the 37 checks actually passed on.
# Upgrade deliberately: change this, redeploy, re-run scripts/prove_workflows.py.
N8N_TAG=2.34.6

# ---- Postgres -------------------------------------------------------------
# Set deliberately at first run. The value is baked into the data volume;
# changing it later without removing the volume breaks authentication.
# Strong, but no special characters — it goes into a connection URL.
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=

# ---- Twenty ---------------------------------------------------------------
# How the browser reaches Twenty, including scheme. Used for generated links
# and to decide whether cookies are secure. Wrong value = login redirect loop.
#   laptop : http://localhost:3000
#   VPS    : https://crm.aspiretss.com
SERVER_URL=http://localhost:3000
TWENTY_PORT=3000

# openssl rand -base64 32
# Losing this loses every secret in the database. Back it up OFF this machine.
ENCRYPTION_KEY=
# Only during a key rotation: set to the previous ENCRYPTION_KEY.
FALLBACK_ENCRYPTION_KEY=
# Required. Upstream's .env.example calls this legacy, but v2.1.0 throws
# "APP_SECRET is not set" at boot without it. up.sh generates it.
APP_SECRET=

STORAGE_TYPE=local

# ---- SMTP (shared by Twenty and the n8n send sub-workflow) ---------------
# Powers invites, password resets, and every email the workflows send.
#
# Leave the SMTP block blank on a local build: scripts/n8n_credentials.py then
# points n8n at the Mailpit container, so the whole send path — consent gate,
# template render, messageLog write, SMTP transaction — runs for real with
# nothing leaving the host. Read the mail at http://localhost:8025.
#
# On a SERVER these are required, not optional. There is no Mailpit there, and
# n8n_credentials.py refuses to invent a relay rather than build a system that
# silently sends nothing — so deploy.sh stops at step 6 without them.
# preflight.sh fails on a missing EMAIL_SMTP_HOST for the same reason.
#
# Two different Gmail connections exist. This block is n8n SMTP (and Twenty's
# transactional driver). Mailbox sync on Person timelines is the Google OAuth
# block below — it does not send workflow mail.
#
# Personal Gmail (App Password, 2-Step Verification required):
#   EMAIL_DRIVER=smtp
#   EMAIL_SMTP_HOST=smtp.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=you@gmail.com
#   EMAIL_SMTP_PASSWORD=<app password, never the account password>
#   EMAIL_SMTP_SECURE=false
#   EMAIL_FROM_ADDRESS=you@gmail.com
#   ASPIRE_FROM_EMAIL=you@gmail.com
# Port 587 + STARTTLS is what n8n's SMTP node expects. Twenty's own
# transactional driver (invites / password reset) can use 465 SSL — that is a
# separate consumer and optional for the live demo. Recreate n8n after
# changing LIVE_MAIL_ALLOWLIST so the env var reaches the container.
#
# Google Workspace relay (not a personal @gmail.com — that host will refuse):
#   EMAIL_SMTP_HOST=smtp-relay.gmail.com
#   EMAIL_SMTP_PORT=587
#   EMAIL_SMTP_USER=<a Workspace user>
#   EMAIL_SMTP_PASSWORD=<an app password, not the account password>
# The relay allows 2,000 recipients/day, 100 per transaction.
EMAIL_DRIVER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
# true = implicit TLS (port 465). false = STARTTLS (port 587). n8n credentials
# read this; Mailpit defaults to false and disables STARTTLS entirely.
EMAIL_SMTP_SECURE=

# ---- Twenty mailbox + calendar sync (optional) ---------------------------
# Native two-way Gmail/Workspace sync. Threads and calendar events appear on
# record timelines — the closest native equivalent to GHL's inbox.
# Does NOT send workflow mail. Requires a Google Cloud OAuth client
# (Testing is enough for one user). See docs/08-local-build.md.
# Laptop redirect URIs, byte-for-byte including http:
#   AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/redirect
#   AUTH_GOOGLE_APIS_CALLBACK_URL=http://localhost:3000/auth/google-apis/get-access-token
# On the VPS the same pair must use SERVER_URL, including https:
#   AUTH_GOOGLE_CALLBACK_URL=https://crm.aspiretss.com/auth/google/redirect
#   AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.aspiretss.com/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=
CALENDAR_PROVIDER_GOOGLE_ENABLED=
AUTH_GOOGLE_ENABLED=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=
AUTH_GOOGLE_APIS_CALLBACK_URL=

# ---- n8n ------------------------------------------------------------------
# Laptop: localhost / http. VPS: init-vps-env.sh sets these to
# auto.aspiretss.com / https. Leaving localhost on a server makes the
# public form render and submit nowhere. preflight.sh fails that.
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_PORT=5678
# openssl rand -base64 32 — losing this loses every stored n8n credential.
N8N_ENCRYPTION_KEY=

# ---- Workflow configuration ----------------------------------------------
# From address for transactional email sent by n8n.
ASPIRE_FROM_EMAIL=
# Comma-separated addresses VEND Send Email is allowed to SMTP. When set, any
# other recipient is refused and logged as Blocked: not_on_allowlist — so seed
# .example.com addresses and prove_workflows fake domains cannot leave the
# host. Empty in production: consent is the only send-time gate. Recreate n8n
# after changing this value. preflight.sh on a VPS **fails** if this is set —
# a laptop Gmail demo .env must not be copied onto the server.
LIVE_MAIL_ALLOWLIST=
# Operator inbox for the live Gmail demo. prove_workflows.py --live-email and
# prove_live_mail.py / rebuild.sh read this when EMAIL_SMTP_HOST is a real relay.
LIVE_DEMO_EMAIL=
# Twenty workspace-member UUIDs for round-robin lead assignment, comma
# separated. Leave blank until users exist — leads then stay unassigned
# rather than failing.
ASPIRE_REP_IDS=

# Bootcamp payment links, one per price tier: TIER=url, comma separated.
# Aspire collects payment off-platform, so this is the only place the CRM
# learns which link belongs to which tier.
#
# ENR Bootcamp Enrolment refuses to guess. Left blank, every enrolment fails
# with "no payment link configured for tier X" rather than emailing a student
# an empty link or — far worse — a link at the wrong price. The error handler
# alerts, so the failure is loud, but the enrolment still does not happen:
# set this before taking the workflow live.
#
# The six live URLs are in GoHighLevel under Marketing -> Trigger Links,
# named "Payment Link - Training <Tier>". Format:
#   ENROL_PAYMENT_LINKS=BRONZE=https://...,SILVER=https://...,GOLD=https://...
ENROL_PAYMENT_LINKS=

# Chat alerts. Any incoming-webhook URL that accepts {"text": "..."} — Slack,
# Mattermost, Discord (add /slack), Google Chat. Not the Slack API node: that
# needs an OAuth app, which cannot be created headlessly and left these
# workflows untestable.
#
# The default points at the dev alert sink workflow, which files each alert as
# an automationRun so alerting is provable before any workspace exists.
#
# REQUIRED on a server, and preflight.sh blocks without it. The sink is a
# --dev workflow and deploy.sh does not deploy those, so this default resolves
# to a path that answers 404 — inside SYS Error Handler, whose entire job is to
# make sure a failure reaches a person. Nothing would look wrong for weeks.
#   Google Chat: a space -> Apps & integrations -> Webhooks -> copy the URL
#   Slack: an incoming webhook
ALERT_WEBHOOK_URL=http://n8n:5678/webhook/alert-sink
# Optional: separate destination for sales notifications. Falls back to
# ALERT_WEBHOOK_URL when blank.
SALES_WEBHOOK_URL=

TZ=UTC

# ---- Scripts (not read by docker compose) --------------------------------
# These stay on localhost even on a server. The scripts run ON the host, where
# both apps are published to 127.0.0.1, so they talk to the app directly and
# skip the proxy, TLS and the editor allowlist. Do NOT change these to the
# public URLs: on the VPS the automation host refuses everything but the form
# and webhooks, so a script pointed at it gets 403 and looks like a bad key.
#
# SERVER_URL above is a different thing and must stay the public address — it
# is what the browser uses, and what the CRM calls when it answers its own
# /rest/metadata/* requests.
#
# Twenty → Settings → API & Webhooks → create key
TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
# n8n → Settings → n8n API → create key, or scripts/bootstrap_n8n.py
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# ---- VPS deployment (ignored by the local stack) -------------------------
# Do not fill this block by hand on a server. Run:
#   ./infra/init-vps-env.sh --yes
# then paste SMTP, N8N_EDITOR_ALLOWED_IPS, ALERT_WEBHOOK_URL and
# ENROL_PAYMENT_LINKS. DNS for both names must already point at the
# server before first start, or the Let's Encrypt HTTP-01 challenge
# fails and Caddy serves an untrusted certificate.
CRM_DOMAIN=
AUTOMATION_DOMAIN=
# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox.
ACME_EMAIL=

# Space-separated CIDRs allowed to open the n8n editor — your office and VPN
# ranges. The editor holds every credential in the stack, so on a public server
# this is the single most important line in this file. Everything else on the
# automation host (the public form, inbound webhooks, the OAuth callback) stays
# reachable by anyone; only the editor is gated.
#   N8N_EDITOR_ALLOWED_IPS=203.0.113.0/24 198.51.100.42/32
# Find your office's public address from inside the office: curl ifconfig.me
# Unset, the proxy refuses to start rather than exposing the editor. Not used
# by the internal deployment, where the network itself is the boundary.
N8N_EDITOR_ALLOWED_IPS=

# Local mail catcher, used by scripts/prove_workflows.py. Dev profile only.
MAILPIT_UI_PORT=8025
MAILPIT_URL=http://localhost:8025
