# Copy to .env and fill in. .env is gitignored — never commit it.
#
# GHL: Settings → Integrations → Private Integrations → create new.
# Tick every scope ending in .readonly. Tick nothing implying write.
# The token is shown ONCE at creation and cannot be viewed again.
GHL_TOKEN=pit-xxxxxxxxxxxxxxxx

# From the sub-account URL:
# https://app.gohighlevel.com/v2/location/<THIS_PART>/settings/...
GHL_LOCATION=

# Agency (company) ID. Leave blank on a sub-account token — agency-class
# endpoints are then skipped and recorded as skipped, not failed.
GHL_COMPANY_ID=

# Twenty instance. Must match the URL the server is configured with (SERVER_URL),
# scheme included, or requests fail in ways that look like auth errors.
TWENTY_BASE_URL=http://localhost:3000
# Twenty → Settings → APIs → Create API key
TWENTY_API_KEY=
